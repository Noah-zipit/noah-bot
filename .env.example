# Noah Bot configuration

# Display name of the bot
BOT_NAME=Saad Bot

# Owner display name
OWNER_NAME=Noah

# Command prefix (default: !)
PREFIX=!

# Owner numbers in format: number|name,number|name
OWNER=923164413714|Noah

# Port for the WhatsApp linking website (http://localhost:3000)
WEB_PORT=3000

# Bind address for the linking website:
# 127.0.0.1 = only this machine (default, safest for local use)
# 0.0.0.0   = all interfaces (needed inside Docker / Railway)
WEB_HOST=127.0.0.1

# Paste a session ID from the pairing service to skip QR/pairing entirely
# (get it from the pairing page after linking your number there)
# SESSION_DATA=

# Gemini API key (paid/billing-enabled) for AI media features (!createvid video generation)
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Telegram bot token for !tgsticker (download Telegram sticker packs as WhatsApp stickers)
# Any bot made with @BotFather works — it only reads public sticker packs
# TELEGRAM_BOT_TOKEN=

# Directory for the local JSON database (users.json, groups.json, settings.json, lidmap.json)
# Default: ./data
# DATA_DIR=./data

# Directory for the WhatsApp session (login state persists here between restarts)
# Default: ./sessions
# SESSION_DIR=./sessions

# Alias for WEB_PORT (either works; WEB_PORT wins) — port of the pairing/linking website
# Default: 3000
# PORT=3000

# Optional outbound HTTP(S) proxy for WhatsApp connection requests
# HTTPS_PROXY=
# HTTP_PROXY=

# Self-hosted music API backing !play (JioSaavn clone). Default: http://127.0.0.1:3100
# JIOSAAVN_API=http://127.0.0.1:3100

# Fish Audio voice id for !tts voice messages (overrides the built-in default voice)
# FISH_VOICE_ID=

# Veo model for !createvid video generation. Default: veo-3.1-generate-preview
# VEO_MODEL=veo-3.1-generate-preview

# Anthropic key + model for the ShopAgent brain. Default model: claude-sonnet-4-5
# ANTHROPIC_API_KEY=<redacted>
# ANTHROPIC_MODEL=claude-sonnet-4-5

# NVIDIA NIM key + model (fallback brain). Default model: meta/llama-3.2-11b-vision-instruct
# NVIDIA_NIM_API_KEY=<redacted>
# NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# Groq key + model (fallback brain). Default model: llama-3.3-70b-versatile
# GROQ_API_KEY=<redacted>
# GROQ_MODEL=llama-3.3-70b-versatile

# Supabase project for cloud sync of the user database (optional).
# Without these, the bot runs in local JSON mode.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=<redacted>

# Default ShopAgent business id answered in non-command DMs (optional)
# DEFAULT_SHOP_BIZ=
